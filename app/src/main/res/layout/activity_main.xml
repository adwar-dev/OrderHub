<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ORDER HUB"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Mengecek Izin..."
        android:textColor="@color/text_grey"
        android:gravity="center"
        android:textSize="12sp"
        android:paddingBottom="8dp"/>

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IZIN NOTIFICATION LISTENER"
        android:backgroundTint="#333333"
        android:textColor="@color/orange_accent"
        android:layout_marginBottom="12dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnFilterAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEMUA" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnFilterGrab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GRAB" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnFilterShopee" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHOPEE" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnFilterIndrive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INDRIVE" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"/>

</LinearLayout>
